{
  "name": "saturn-console",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt generate && node scripts/externalize-scripts.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "docs:generate": "node scripts/build-documentation.mjs",
    "predev": "npm run docs:generate",
    "pretypecheck": "npm run docs:generate",
    "prebuild": "npm run docs:generate"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@pinia/colada": "^1.4.8",
    "@pinia/colada-nuxt": "^1.2.0",
    "@pinia/nuxt": "^1.0.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "echarts": "^6.0.0",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "^2.8.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.0",
    "vue-echarts": "^8.0.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "github-slugger": "^2.0.0",
    "markdown-it": "^15.0.3",
    "parse5": "^8.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  },
  "license": "LGPL-3.0-or-later",
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
