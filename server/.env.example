# Use a unique password; URL-encode reserved characters in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://saturn:replace-with-a-random-password@postgres:5432/saturn
# Optional legacy management token. Prefer named, app-scoped keys from Settings.
ADMIN_TOKEN=
# Set a random 32–256 character token, then open /setup in your browser.
SETUP_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
HOST_PORT=3000
RUST_LOG=info

# Optional automated first-account seeding; browser onboarding is the default.
# ADMIN_USERNAME=admin
# Legacy set-login.sh can generate this hash. Browser onboarding does not need it.
# Used only when there are no accounts yet.
# ADMIN_PASSWORD_HASH='$argon2id$...'
