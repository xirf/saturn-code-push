# Use a unique password; URL-encode reserved characters in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://saturn:replace-with-a-random-password@postgres:5432/saturn
# Optional legacy management token. Prefer named, app-scoped keys from Settings.
ADMIN_TOKEN=
# Set a random 32–256 character token, then open /setup in your browser.
SETUP_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
HOST_PORT=3000
RUST_LOG=info

# Optional automated first-account seeding; browser onboarding is the default.
# ADMIN_USERNAME=admin
# Legacy set-login.sh can generate this hash. Browser onboarding does not need it.
# Used only when there are no accounts yet.
# ADMIN_PASSWORD_HASH='$argon2id$...'

# Optional GitHub Actions synchronization (configure all four to enable).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Path inside the container to a read-only mounted private key, never the PEM contents.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
# For compose.github.yaml only: absolute host path to the private key.
# GITHUB_APP_PRIVATE_KEY_HOST_FILE=/secure/saturn/github-app.pem

# Artifact storage. Existing flat files remain readable after switching.
STORAGE_BACKEND=local
# Required when STORAGE_BACKEND=s3; keep configured to read prior S3 files.
# STORAGE_S3_BUCKET=saturn-artifacts
# STORAGE_S3_REGION=us-east-1
# Optional for R2/MinIO/other S3 providers; use a publicly reachable HTTPS origin.
# STORAGE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_S3_PREFIX=saturn
# Development MinIO only (never disables certificate verification):
STORAGE_S3_ALLOW_HTTP=false
# Supply credentials via hosting secrets, or use an AWS workload role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
